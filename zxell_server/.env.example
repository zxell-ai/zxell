# zxell_server 設定の書式サンプル（実値はダミー）
#
# 正式手順は環境変数で渡すこと:
#   export ZXELL_DB_URL="postgresql://zxell:実パスワード@localhost/zxell_db"
#   export ZXELL_ADMIN_API_KEY="実キー"
#
# 開発時はこのファイルを .env にコピーして実値を書いてもよい（.env は gitignore 済み）:
#   cp .env.example .env

# PostgreSQL 接続 URL（必須）
ZXELL_DB_URL=postgresql://zxell:CHANGE_ME@localhost/zxell_db

# 管理 API キー（必須）。生成例: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ZXELL_ADMIN_API_KEY=CHANGE_ME

# 以下は任意（デフォルトあり）
#ZXELL_STORAGE_DIR=storage
#ZXELL_LEASE_SECONDS=3600
